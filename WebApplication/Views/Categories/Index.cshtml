@model IEnumerable<BusinessLayer.Entities.Category>

@{
    ViewData["Title"] = "Категории ремонти";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Категории ремонти</h2>
    <a asp-action="Create" class="btn btn-primary">+ Нова категория</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Име</th>
            <th>Описание</th>
            <th class="text-end">Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редакция</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Изтрий</a>
                    </td>
                </tr>
        }
    </tbody>
</table>