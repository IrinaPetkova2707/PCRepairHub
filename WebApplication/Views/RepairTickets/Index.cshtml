@model IEnumerable<BusinessLayer.Entities.RepairTicket>

@{
    ViewData["Title"] = "Заявки за ремонт";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@(User.IsInRole("Admin") ? "Всички заявки за ремонт" : "Моите заявки за ремонт")</h2>
    <a asp-action="Create" class="btn btn-primary">+ Подай нова заявка</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Устройство</th>
            <th>Категория</th>
            @if (User.IsInRole("Admin"))
            {
                <th>Клиент</th>
            }
            <th>Статус</th>
            <th>Цена</th>
            <th>Дата</th>
            <th class="text-end">Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.DeviceModel</strong></td>
                <td>@item.Category?.Name</td>
                @if (User.IsInRole("Admin"))
                {
                    <td>@item.Client?.Email</td>
                }
                <td><span class="badge bg-info text-dark">@item.Status</span></td>
                <td>@(item.EstimatedPrice.HasValue ? $"{item.EstimatedPrice:F2} лв." : "Очаква оценка")</td>
                <td>@item.CreatedOn.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Детайли</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редакция</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Изтрий</a>
                </td>
            </tr>
        }
    </tbody>
</table>